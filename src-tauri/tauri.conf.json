{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Merger",
  "version": "0.1.0",
  "identifier": "com.codemerger.desktop",
  "build": {
    "beforeBuildCommand": "node desktop/prepare.mjs",
    "frontendDist": "../desktop/ui"
  },
  "app": {
    "windows": [],
    "security": { "capabilities": [] }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "One chat for all your coding agents",
    "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "externalBin": ["binaries/node"],
    "resources": { "resources/server/": "server/" },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 600, "height": 400 },
        "appPosition": { "x": 170, "y": 190 },
        "applicationFolderPosition": { "x": 430, "y": 190 }
      }
    }
  }
}
